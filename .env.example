# Port the server listens on (participant, display and control all share it)
PORT=3000
# ---- MUST BE UPDATED before the talk ----
# Secret that unlocks the console, the facilitator view, the notes view and the export (?key=...). Choose a long random
# value. The server refuses to start while it is empty or still holds this placeholder.
SPEAKER_KEY=CHOOSE-A-SECRET
# Optional live model. Leave everything below unset to run fully offline in deterministic mode.
# Provider: anthropic | openai | openai-responses | openai-compatible | ollama
# Unset: anthropic when ANTHROPIC_API_KEY is set, openai when OPENAI_API_KEY is set.
LLM_PROVIDER=
# Model name. Defaults: anthropic claude-opus-5, openai gpt-5. Required for openai-compatible and ollama.
LLM_MODEL=
# Keys. LLM_API_KEY works for any provider; the named ones are honored as fallbacks.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=
# API root. Defaults: OpenAI https://api.openai.com/v1, Ollama http://localhost:11434 (or OLLAMA_HOST).
# Required for openai-compatible, e.g. http://localhost:11434/v1 (Ollama), http://localhost:1234/v1 (LM Studio), a vLLM server.
LLM_BASE_URL=
# Reasoning effort: off | minimal | low | medium | high. Default low for anthropic/openai/openai-responses,
# not sent for openai-compatible/ollama unless set. openai-compatible: a level sends reasoning_effort (set low for
# gpt-oss, or its reasoning can use up LLM_MAX_TOKENS and leave no answer); off turns thinking off for Qwen3-style
# models. Ollama: off sends think=false, a level sends think=<level> (gpt-oss).
LLM_EFFORT=
# Local model example (oMLX on port 8000; LM Studio is usually 1234):
#   LLM_PROVIDER=openai-compatible
#   LLM_BASE_URL=http://localhost:8000/v1
#   LLM_MODEL=gpt-oss-20b-MXFP4-Q8
#   LLM_EFFORT=low
# Answer budget and how long to wait before falling back to the deterministic answer.
LLM_MAX_TOKENS=400
LLM_TIMEOUT_MS=8000
# ---- MUST BE UPDATED before the talk ----
# The two values below are placeholders for this generic copy of the project. The server refuses to start while
# either still holds its placeholder.
# PUBLIC_URL: the address the QR code encodes, i.e. where the audience's devices reach this server. Set it to your
# own public URL (https://talk.example.com, or https://host/talk to serve under a path). Leave it EMPTY to use the
# machine's LAN address, http://<lan-ip>:<port>, which only works when every device is on the same network.
PUBLIC_URL=https://YOUR-PUBLIC-HOST
# SHORT_URL: the text printed under the QR code instead of the site root, e.g. a short link that redirects to
# PUBLIC_URL. Display only. Set it to your own short link, or leave it EMPTY to print the site root.
SHORT_URL=YOUR-SHORT-LINK
# Folder of slide images the console can put on the display. Defaults to ./slides
SLIDES_DIR=
# Speaker notes file, one note per run sheet step. Defaults to ./notes/speaker-notes.md
NOTES_FILE=
# 1 turns saving notes off; the notes view still shows them. Set on the cluster, where a save would not survive a deploy.
NOTES_READONLY=
